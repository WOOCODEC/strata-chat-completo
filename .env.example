# ---------------------------------------------------------------------------
# Configuracion del chat local con Strata. Copia este archivo a `.env`.
# TODO apunta a tu propio equipo: no hay ninguna llamada a internet.
# ---------------------------------------------------------------------------

# Interfaz del servidor Express. 127.0.0.1 = solo accesible desde este PC.
HOST=127.0.0.1
PORT=3000

# Tu IA local (compatibilidad OpenAI). Cambia el puerto si Strata usa otro.
STRATA_BASE_URL=http://127.0.0.1:8080/v1
# La clave es un placeholder: Strata no la valida, pero el SDK de OpenAI exige que no este vacia.
STRATA_API_KEY=strata-local
# Nombre del modelo. Si se deja vacio se usa el primero que declare GET /v1/models.
STRATA_MODEL=qwen3.8-flash-next-iq3_s

# Ruta de la base de datos SQLite (relativa a la raiz del proyecto).
DB_PATH=./database/chat.db

# Cuantos mensajes de historial se reenvian al modelo (protege la ventana de contexto).
MAX_HISTORY_MESSAGES=24
TEMPERATURE=0.7
# Limite de tokens de respuesta. Dejalo vacio para que Strata decida.
MAX_TOKENS=
# Tiempo de peticion al modelo en milisegundos.
REQUEST_TIMEOUT_MS=180000

# Adjuntos de imagen: cuantas y cuanto pueden pesar.
MAX_IMAGES_PER_MESSAGE=4
MAX_IMAGE_BYTES=4194304

# Adjuntos de documento (PDF). El servidor les saca el texto en local y solo ese
# texto llega al modelo; nunca se envia el binario del PDF.
MAX_PDF_PER_MESSAGE=4
MAX_PDF_BYTES=8388608
# Caracteres de texto que se aprovechan de cada PDF (los recortes de seguridad).
MAX_PDF_TEXT_CHARS=12000
# Presupuesto total de texto de PDF que se mete en un mismo aviso al modelo.
MAX_PDF_TOTAL_CHARS=40000

# Salvaguarda de privacidad: si es false el servidor RECHAZA cualquier base URL
# que no sea loopback (127.0.0.1 / localhost / ::1). Guerala en false.
ALLOW_REMOTE_STRATA=false